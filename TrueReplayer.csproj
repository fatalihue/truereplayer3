<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<Compile Remove="NativeHost\**" />
		<None Remove="NativeHost\**" />
		<Content Remove="NativeHost\**" />
		<Compile Remove="ChromeExtension\**" />
		<None Remove="ChromeExtension\**" />
		<Content Remove="ChromeExtension\**" />
		<Compile Remove="tools\**" />
		<None Remove="tools\**" />
		<Content Remove="tools\**" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<Version>3.2.0</Version>
		<AssemblyVersion>3.2.0.0</AssemblyVersion>
		<FileVersion>3.2.0.0</FileVersion>
		<!-- TrueReplayer 3 beside TrueReplayer 2: the exe keeps its name (AssemblyName), and what
		     Windows shows comes from these — Task Manager reads the description from AssemblyTitle.
		     Every other name comes from Source/AppIdentity.cs. -->
		<Product>TrueReplayer 3</Product>
		<AssemblyTitle>TrueReplayer 3</AssemblyTitle>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>TrueReplayer</RootNamespace>
		<ApplicationIcon>TrueReplayer3.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<NoWarn>$(NoWarn);MSB3243;APPX0104;APPX0107</NoWarn>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
		<WindowsPackagedType>None</WindowsPackagedType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- WinUI and this app share the WebView2 projection that the Microsoft.Web.WebView2 package
		     below ships for its winmd, so that one version decides both. Microsoft.WinUI.props already
		     turns it on for SDK-style projects; stated here so it never hangs on import order. -->
		<WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- Prunes the default item globs' traversal — node_modules alone is ~12.4k items walked per evaluation. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);frontend/node_modules/**;frontend/releases/**;frontend/dist/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
	  <Content Remove="Assets\SmallTile.scale-100.png" />
	  <Content Remove="Assets\SmallTile.scale-125.png" />
	  <Content Remove="Assets\SmallTile.scale-150.png" />
	  <Content Remove="Assets\SmallTile.scale-200.png" />
	  <Content Remove="Assets\SmallTile.scale-400.png" />
	  <Content Remove="Assets\SplashScreen.scale-100.png" />
	  <Content Remove="Assets\SplashScreen.scale-125.png" />
	  <Content Remove="Assets\SplashScreen.scale-150.png" />
	  <Content Remove="Assets\SplashScreen.scale-400.png" />
	  <Content Remove="Assets\Square150x150Logo.scale-100.png" />
	  <Content Remove="Assets\Square150x150Logo.scale-125.png" />
	  <Content Remove="Assets\Square150x150Logo.scale-150.png" />
	  <Content Remove="Assets\Square150x150Logo.scale-400.png" />
	  <Content Remove="Assets\Square310x310Logo.scale-100.png" />
	  <Content Remove="Assets\Square310x310Logo.scale-125.png" />
	  <Content Remove="Assets\Square310x310Logo.scale-150.png" />
	  <Content Remove="Assets\Square310x310Logo.scale-200.png" />
	  <Content Remove="Assets\Square310x310Logo.scale-400.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-lightunplated_targetsize-16.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-lightunplated_targetsize-24.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-lightunplated_targetsize-256.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-lightunplated_targetsize-32.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-lightunplated_targetsize-48.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-unplated_targetsize-16.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-unplated_targetsize-256.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-unplated_targetsize-32.png" />
	  <Content Remove="Assets\Square44x44Logo.altform-unplated_targetsize-48.png" />
	  <Content Remove="Assets\Square44x44Logo.scale-100.png" />
	  <Content Remove="Assets\Square44x44Logo.scale-125.png" />
	  <Content Remove="Assets\Square44x44Logo.scale-150.png" />
	  <Content Remove="Assets\Square44x44Logo.scale-400.png" />
	  <Content Remove="Assets\Square44x44Logo.targetsize-16.png" />
	  <Content Remove="Assets\Square44x44Logo.targetsize-24.png" />
	  <Content Remove="Assets\Square44x44Logo.targetsize-256.png" />
	  <Content Remove="Assets\Square44x44Logo.targetsize-32.png" />
	  <Content Remove="Assets\Square44x44Logo.targetsize-48.png" />
	  <Content Remove="Assets\Wide310x150Logo.scale-100.png" />
	  <Content Remove="Assets\Wide310x150Logo.scale-125.png" />
	  <Content Remove="Assets\Wide310x150Logo.scale-150.png" />
	  <Content Remove="Assets\Wide310x150Logo.scale-400.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
	</ItemGroup>

	<ItemGroup>
		<None Include="TrueReplayer3.ico">
			<Pack>True</Pack>
			<PackagePath>Assets\</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- The example macros (decision 4 of the interface swap): the package the manual offers for
	     download, generated by tools\ExampleProfiles. Embedded rather than copied next to the exe,
	     because CleanLocalesFolders below deletes every top-level publish folder it does not know. -->
	<ItemGroup>
		<None Remove="Examples\**" />
		<EmbeddedResource Include="Examples\TrueReplayer-exemplos.trprofile" LogicalName="TrueReplayer.Examples.trprofile" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <!-- Allowlist re-serializer for imported SendText rich text (Source/HtmlSanitizer.cs). A real
         HTML parser is required — regex cannot safely parse HTML, and the paste targets are
         Word/Outlook/Gmail's own quirky importers. MIT, netstandard2.0, managed-only. -->
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <!-- Deck (branch deck): the decks' native windows draw with Direct2D + DirectWrite (MIT, managed bindings only). -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <!-- Frontend sources that trigger an incremental rebuild of frontend/dist.
       Defined at project scope (not inside the Target) because BuildFrontend's
       Inputs="..." attribute is evaluated by MSBuild BEFORE the target body
       runs — an ItemGroup inside the target wouldn't be visible yet. -->
  <ItemGroup>
    <FrontendSources Include="frontend\src\**\*.ts" />
    <FrontendSources Include="frontend\src\**\*.tsx" />
    <FrontendSources Include="frontend\src\**\*.css" />
    <!-- What `npm run build` reads beyond src: the boot-mirror generator (its first step rewrites
         index.html from themes.ts) and public/, which Vite copies into dist verbatim (the update
         splash's app-icon.png). A change to either alone left this target skipped, and the build
         shipped the previous dist with nothing to say so. -->
    <FrontendSources Include="frontend\tools\**\*.mjs" />
    <FrontendSources Include="frontend\public\**\*" />
    <!-- The text catalog and the tools that put it in the page, one build per language (plan of
         languages, §3.3). -->
    <!-- Not the engine's areas (engine-*.ts): the page never reads them, and a C# build after an
         engine text changed would otherwise rebuild the page for nothing. -->
    <FrontendSources Include="i18n\**\*.ts" Exclude="i18n\**\engine-*.ts" />
    <FrontendSources Include="tools\vite-i18n.mjs;tools\i18n-lib.mjs;tools\gen-i18n.mjs" />
  </ItemGroup>

  <!-- Run "npm run build" before the dist→wwwroot copy when any frontend source
       (TS/TSX/CSS) or build config is newer than the existing dist output.
       Inputs/Outputs gives MSBuild an incremental-build cache: if nothing changed
       since the last npm build, this target is skipped (zero cost — preserves
       fast C#-only iteration). Adds ~3s when the frontend actually needs
       rebuilding, which is the explicit trade-off the user signed up for to
       avoid the "preview shows changes, VS doesn't" stale-dist gotcha. -->
  <Target Name="BuildFrontend"
          BeforeTargets="CopyFrontendDist;CopyFrontendDistPublish"
          Condition="Exists('frontend\package.json')"
          Inputs="frontend\package.json;frontend\package-lock.json;frontend\vite.config.ts;frontend\tsconfig.json;frontend\tsconfig.app.json;frontend\tsconfig.node.json;frontend\index.html;@(FrontendSources)"
          Outputs="frontend\dist\en-US\index.html">
    <Message Text="Frontend sources changed — running 'npm run build' in frontend/..." Importance="high" />
    <!-- cmd /c is required on Windows because npm is a .cmd shim, not a real exe.
         The MSBuild Exec task on Linux/macOS would still resolve `npm` directly
         via PATH; the prefix is harmless there. -->
    <Exec Command="cmd /c npm run build" WorkingDirectory="frontend" />
  </Target>

  <!-- Copy React build output to wwwroot in binary output directory.
       Both copies below PRUNE first-class: Copy alone is purely additive, and Vite puts a content
       hash in every asset filename, so each frontend change used to leave the PREVIOUS bundle
       behind in wwwroot\assets forever — unreferenced by index.html but still copied into the
       publish output and shipped. A single stale entry point is ~1 MB of dead JS in a release whose
       whole delta is a couple of MB, and nothing ever noticed because the app works fine.

       Delete-what's-missing rather than RemoveDir-then-recopy, deliberately: wiping the folder
       would defeat SkipUnchangedFiles and re-copy the whole bundle on every build, including the
       C#-only builds that BuildFrontend's incremental cache above exists to keep free. Pruning
       after the copy (not before) means a failed copy leaves wwwroot complete-plus-stale rather
       than incomplete. The stale set is disjoint from what was just written, so the order does not
       change the result — only the failure mode. -->
  <Target Name="CopyFrontendDist" AfterTargets="Build" Condition="Exists('frontend\dist')">
    <ItemGroup>
      <!-- dist\qps is the pseudo-localized page the tests sweep (npm run build:qps): never shipped. -->
      <FrontendFiles Include="frontend\dist\**\*" Exclude="frontend\dist\qps\**" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ExpectedWwwroot Include="@(FrontendFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
      <ExistingWwwroot Include="$(OutDir)wwwroot\**\*" />
      <StaleWwwroot Include="@(ExistingWwwroot)" Exclude="@(ExpectedWwwroot)" />
    </ItemGroup>
    <Message Text="Pruning %(StaleWwwroot.Identity) (no longer in frontend/dist)" Importance="high" Condition="'@(StaleWwwroot)' != ''" />
    <Delete Files="@(StaleWwwroot)" />
  </Target>
  <Target Name="CopyFrontendDistPublish" AfterTargets="Publish" Condition="Exists('frontend\dist')">
    <ItemGroup>
      <FrontendFilesPublish Include="frontend\dist\**\*" Exclude="frontend\dist\qps\**" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFilesPublish)" DestinationFiles="@(FrontendFilesPublish->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ExpectedWwwrootPublish Include="@(FrontendFilesPublish->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
      <ExistingWwwrootPublish Include="$(PublishDir)wwwroot\**\*" />
      <StaleWwwrootPublish Include="@(ExistingWwwrootPublish)" Exclude="@(ExpectedWwwrootPublish)" />
    </ItemGroup>
    <Message Text="Pruning %(StaleWwwrootPublish.Identity) from the publish payload (no longer in frontend/dist)" Importance="high" Condition="'@(StaleWwwrootPublish)' != ''" />
    <Delete Files="@(StaleWwwrootPublish)" />
  </Target>
  <!-- Copy Chrome Extension files to output/publish for bundled distribution.
       Both copies prune after the Copy, delete-what's-missing — same rationale as the
       wwwroot copies above (see the CopyFrontendDist comment for why never RemoveDir). -->
  <Target Name="CopyChromeExtension" AfterTargets="Build">
    <ItemGroup>
      <ChromeExtFiles Include="ChromeExtension\**\*" Exclude="ChromeExtension\**\.git*" />
    </ItemGroup>
    <Copy SourceFiles="@(ChromeExtFiles)" DestinationFiles="@(ChromeExtFiles->'$(OutDir)ChromeExtension\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ExpectedChromeExt Include="@(ChromeExtFiles->'$(OutDir)ChromeExtension\%(RecursiveDir)%(Filename)%(Extension)')" />
      <ExistingChromeExt Include="$(OutDir)ChromeExtension\**\*" />
      <StaleChromeExt Include="@(ExistingChromeExt)" Exclude="@(ExpectedChromeExt)" />
    </ItemGroup>
    <Message Text="Pruning %(StaleChromeExt.Identity) (no longer in ChromeExtension/)" Importance="high" Condition="'@(StaleChromeExt)' != ''" />
    <Delete Files="@(StaleChromeExt)" />
  </Target>
  <Target Name="CopyChromeExtensionPublish" AfterTargets="Publish">
    <ItemGroup>
      <ChromeExtFilesPublish Include="ChromeExtension\**\*" Exclude="ChromeExtension\**\.git*" />
    </ItemGroup>
    <Copy SourceFiles="@(ChromeExtFilesPublish)" DestinationFiles="@(ChromeExtFilesPublish->'$(PublishDir)ChromeExtension\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ExpectedChromeExtPublish Include="@(ChromeExtFilesPublish->'$(PublishDir)ChromeExtension\%(RecursiveDir)%(Filename)%(Extension)')" />
      <ExistingChromeExtPublish Include="$(PublishDir)ChromeExtension\**\*" />
      <StaleChromeExtPublish Include="@(ExistingChromeExtPublish)" Exclude="@(ExpectedChromeExtPublish)" />
    </ItemGroup>
    <Message Text="Pruning %(StaleChromeExtPublish.Identity) from the publish payload (no longer in ChromeExtension/)" Importance="high" Condition="'@(StaleChromeExtPublish)' != ''" />
    <Delete Files="@(StaleChromeExtPublish)" />
  </Target>
  <!-- Copy NativeHost.exe to output directory for Chrome Extension support -->
  <Target Name="CopyNativeHost" AfterTargets="Build" Condition="Exists('NativeHost\publish\TrueReplayer.NativeHost.exe')">
    <Copy SourceFiles="NativeHost\publish\TrueReplayer.NativeHost.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyNativeHostPublish" AfterTargets="Publish" Condition="Exists('NativeHost\publish\TrueReplayer.NativeHost.exe')">
    <Copy SourceFiles="NativeHost\publish\TrueReplayer.NativeHost.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Remove WinUI/WinAppSDK locale folders (keep only en-us, wwwroot, Microsoft.UI.Xaml) -->
  <Target Name="CleanLocalesFolders" AfterTargets="CopyFrontendDistPublish">
    <ItemGroup>
      <AllPublishDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <!-- ChromeExtension is kept explicitly: MSBuild does not guarantee this target runs before CopyChromeExtensionPublish, and running after it would silently delete the extension from the publish. -->
      <KeepDirs Include="$(PublishDir)en-us;$(PublishDir)wwwroot;$(PublishDir)Microsoft.UI.Xaml;$(PublishDir)ChromeExtension" />
      <RemoveDirs Include="@(AllPublishDirs)" Exclude="@(KeepDirs)" />
    </ItemGroup>
    <RemoveDir Directories="@(RemoveDirs)" />
  </Target>
  <!-- TrueReplayer 3's icons (AppIdentity.IconFile*), built from TrueReplayer 2's by
       tools/icones-3.ps1 and tools/icones-estado.ps1 (the tray's states); the TrueReplayer*.ico
       files without the 3 are only their source. -->
  <ItemGroup>
    <None Update="TrueReplayer3.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TrueReplayer3Purple.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TrueReplayer3Recording.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TrueReplayer3Replaying.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TrueReplayer3Off.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TrueReplayer3Alert.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The identity gate (plan truereplayer3-paralelo-2026-10-30.md, decision 3): "TrueReplayer"
       building a path or naming the app outside Source/AppIdentity.cs fails the build, because one
       path that slipped through would write into TrueReplayer 2's data. The page's half runs at the
       end of npm run build. -->
  <!-- The engine's texts (Source/Strings.g.cs) come from the same catalog as the page's (i18n/, plan
       of languages §3.5). The generator checks the catalog and rewrites the file only when it changed,
       so the compile always sees the catalog as it is. -->
  <Target Name="I18nStrings" BeforeTargets="CoreCompile">
    <Exec Command="node tools/gen-i18n.mjs" />
  </Target>
  <Target Name="IdentityGate" BeforeTargets="CoreCompile">
    <Exec Command="node tools/identidade-gate.mjs cs" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <PackageCertificateKeyFile>TrueReplayer_TemporaryKey.pfx</PackageCertificateKeyFile>
    <!-- Off: the app ships unpackaged through Velopack and never builds an MSIX to sign, and that .pfx
         was never in the repository. With it on, the MSIX tools Windows App SDK 2.x brings
         (Microsoft.Windows.SDK.BuildTools.MSIX) check the certificate on every build and warn
         SigningCertificateFileNotFound. -->
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>True</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
  </PropertyGroup>
</Project>