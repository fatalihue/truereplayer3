{
  "name": "frontend",
  "private": true,
  "version": "3.0.0-preview.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run mirror && npm run lint:gate && tsc -b && vite build && node ../tools/identidade-gate.mjs dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "mirror": "node tools/gen-boot-mirror.mjs",
    "mirror:check": "node tools/gen-boot-mirror.mjs --check",
    "lint:gate": "eslint -c eslint.gate.config.js --suppressions-location eslint-gate-suppressions.json .",
    "lint:gate:prune": "eslint -c eslint.gate.config.js --suppressions-location eslint-gate-suppressions.json --prune-suppressions .",
    "lint:gate:accept": "eslint -c eslint.gate.config.js --suppressions-location eslint-gate-suppressions.json --suppress-all .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/html": "^0.44.0",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "emoji-picker-react": "^4.18.0",
    "lexical": "^0.44.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
